# Set default behavior to automatically normalize line endings
* text=auto
# Explicitly declare text files
*.rs text
*.ts text
*.tsx text
*.js text
*.jsx text
*.json text
*.css text
*.md text
*.html text
*.toml text
*.yml text
*.yaml text
*.env text
*.gitignore text
*.gitattributes text
# Treat images and binaries as binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.pdf binary
*.exe binary
*.dll binary
*.so binary
*.dylib binary
*.wasm binary
# Prevent linguist from classifying lock files as generated
Cargo.lock linguist-generated=false
pnpm-lock.yaml linguist-generated=false
